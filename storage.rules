rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for marketplace assets (products, shop logos, banners)
    // Allow writes for valid image uploads under 10MB
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
