# ==========================================
# Sokoza Multi-Seller Marketplace Configuration
# ==========================================

# Public Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for browser client)
# NEVER put service_role secret here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Brand Configuration (Easily customized globally)
VITE_APP_BRAND_NAME=Sokoza
VITE_APP_BRAND_TAGLINE=Your Shop. Your Market.
VITE_APP_DEFAULT_CURRENCY=TZS
VITE_APP_COUNTRY_CODE=255

# Storage bucket names (configured in Supabase Storage)
VITE_SUPABASE_STORAGE_BUCKET_SHOPS=shop-assets
VITE_SUPABASE_STORAGE_BUCKET_PRODUCTS=product-images


# ==========================================
# Firebase Configuration
# ==========================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
